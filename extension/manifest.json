{
  "manifest_version": 3,

  "name": "Personal LinkedIn Copilot",

  "version": "2.0.0",

  "description": "Local LinkedIn research, resume selection and networking assistant powered by Ollama.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],

  "background": {
    "service_worker": "service-worker.js"
  },

  "action": {
    "default_title": "Personal LinkedIn Copilot",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}